{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeCoAuthoredBy": true,
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Agent",
      "Read(**)",
      "Edit(**)",
      "Write(**)",
      "Grep(**)",
      "Glob(**)",
      "mcp__playwright",
      "mcp__plugin_playwright_playwright",
      "mcp__claude_ai_Gmail__send_message",
      "Bash(docker exec:*)",
      "Bash(docker compose -f docker/docker-compose.rsp.yml:*)",
      "Bash(docker ps:*)",
      "Bash(npm run build:*)",
      "Bash(npm ci:*)",
      "Bash(cd:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git branch --show-current:*)",
      "Bash(git ls-files:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(tr:*)",
      "Bash(diff:*)",
      "Bash(echo:*)",
      "Bash(date:*)",
      "Bash(test:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(pwd:*)",
      "Bash(python3:*)",
      "Bash(php -l:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git checkout main:*)",
      "Bash(git switch main:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git worktree:*)",
      "Bash(gh:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(docker exec arovolife-app:*)",
      "Bash(docker exec arovolife-db:*)",
      "Bash(docker exec -e DB_CONNECTION=mysql -e DB_DATABASE=arovolife_test -e DB_HOST=db -e DB_PORT=3306 -e DB_USERNAME=arovolife -e DB_PASSWORD=secret arovolife-app:*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker volume:*)",
      "Bash(docker system prune:*)",
      "Bash(docker exec arovolife-rsp-app php artisan migrate:fresh:*)",
      "Bash(docker exec arovolife-rsp-app php artisan migrate:refresh:*)",
      "Bash(docker exec arovolife-rsp-app php artisan migrate:reset:*)",
      "Bash(docker exec arovolife-rsp-app php artisan migrate:rollback:*)",
      "Bash(docker exec arovolife-rsp-app php artisan db:wipe:*)",
      "Bash(docker exec arovolife-rsp-app php artisan test:*)",
      "Write(**/.env)",
      "Edit(**/.env)",
      "Write(.env)",
      "Edit(.env)",
      "mcp__cloudways",
      "mcp__github",
      "mcp__claude_ai_Razorpay"
    ]
  }
}
