APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Dedicated, stable key for personal data at rest (PAN/Aadhaar/bank) — ADR-0008.
# Independent of APP_KEY so APP_KEY rotation never makes PII unreadable.
# Generate one with: php artisan key:generate --show  (use the printed base64:... value)
# Keep it OUT of the repo image — provision via your secret manager.
# When blank, PII falls back to APP_KEY (existing behaviour).
PII_ENCRYPTION_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Session payloads live in the database and can hold PII in flash messages.
SESSION_ENCRYPT=true
# Leave unset in production: it then defaults to true (HTTPS-only cookie).
# Set to false only for local HTTP development.
SESSION_SECURE_COOKIE=false
# `strict` would break the payment-gateway return leg when it lands; `lax`
# still blocks cross-site POST, which is what CSRF needs.
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# CACHE_STORE, not CACHE_DRIVER (renamed in Laravel 11) -- the old key is
# ignored silently and the app quietly falls back to the `database` store.
# Staging and production run `redis`.
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Leave REDIS_USERNAME / REDIS_PASSWORD / REDIS_PREFIX unset. Cloudways shows
# a per-app ACL triplet under Access Details -> Redis, but the ACL user is
# never actually created (verified 2026-08-28): using those values fails
# WRONGPASS on every call and takes down sessions along with the cache.
# See docs/runbooks/cloudways-deployment.md 1.5 before changing this.

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Analytics 4 measurement ID. Leave blank to disable gtag entirely.
# Public-facing layouts (landing, registration wizard, auth, content,
# shop, contact) emit the GA loader only when this is set. Admin console
# never emits GA regardless. See config/arovolife.php → analytics.google_id.
GOOGLE_ANALYTICS_ID=

# TESTING ONLY — unlocks `compensation:recompute-all` and its admin button,
# which wipe every BV-derived row (bonuses, pools, carry-forwards, repurchase
# cycles, wallet credits, payout batches) and replay the engines from the
# first BV date. Never set this in production; the guard refuses there anyway.
# Slated for deletion once the compensation plan is signed off.
COMP_RECOMPUTE_ENABLED=false

# The second half of that gate, and the one APP_ENV cannot answer: a recompute
# or a purchase-data reset refuses unless the CONNECTED DATABASE is named here
# (comma-separated). A permitted build pointed at a real database still stops,
# so an operator cannot destroy statutory records — cooling-off windows,
# invoices, buyback evidence, the TDS trail — by mislabelling an environment.
COMP_RECOMPUTE_ALLOWED_DATABASES=
